{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicGamepad",
  "version": "0.1.0",
  "identifier": "com.musicgamepad.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "MusicGamepad",
        "width": 1280,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "MusicGamepad",
    "copyright": "© 2026 MusicGamepad",
    "category": "Music",
    "shortDescription": "Геймпад как музыкальный инструмент",
    "longDescription": "Играй на геймпаде как на инструменте: встроенный звук или MIDI в DAW, полная переназначаемость кнопок, стиков и курков.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "MusicGamepad"
      }
    }
  }
}